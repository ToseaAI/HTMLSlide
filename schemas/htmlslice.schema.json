{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tosea.ai/schemas/htmlslice.schema.json",
  "title": "HTMLSlice Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "title", "slides"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "aspectRatio": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "width": {
      "type": "number",
      "minimum": 1
    },
    "height": {
      "type": "number",
      "minimum": 1
    },
    "sourceSkill": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["src"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "src": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.html?$"
          }
        }
      }
    }
  }
}

